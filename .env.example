# === apps/api ===
# Neon PostgreSQL connection string
DATABASE_URL=

# OpenAI API key (usada como fallback; los usuarios pueden guardar la suya cifrada)
OPENAI_API_KEY=

# Clave AES-256-GCM en hex de 32 bytes para cifrar las API keys de los usuarios
ENCRYPTION_KEY=

# Secreto de sesiones de better-auth
BETTER_AUTH_SECRET=

# URL base pública de la app (usada por better-auth como baseURL y trustedOrigin).
# En prod (single-domain) es el dominio de Railway; en local http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Origen permitido por CORS (solo relevante si api y web están en dominios distintos)
WEB_ORIGIN=http://localhost:5173

# Infraestructura
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# === apps/web (build-time, Vite) ===
# URL base de la API. En prod (single-domain) = dominio de Railway; en local http://localhost:3000
VITE_API_URL=http://localhost:3000
